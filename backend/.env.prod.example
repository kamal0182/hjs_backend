# Copy to backend/.env.prod for docker-compose.prod.yml. Never commit the real file.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
DEBUG=False

# Hostnames the site is served on (the Host header nginx forwards)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Keep True when HTTPS is terminated in front of nginx (it sends X-Forwarded-Proto).
# Set to False only to try the prod stack locally over plain http://localhost.
SECURE_SSL_REDIRECT=True

# PostgreSQL (the "db" service). Use the same strong password in both lines.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://hjs:change-me@db:5432/hjs

# Set by docker-compose.prod.yml: NUM_PROXIES=1 (nginx), CACHE_URL=filecache:///app/data/cache.
# If you add another proxy/load balancer in front of nginx, raise NUM_PROXIES accordingly.

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Optional: created on first start if the email does not exist yet.
# DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
# DJANGO_SUPERUSER_PASSWORD=change-me-strong-password

# Email (SMTP). Leave SMTP_HOST empty to print emails to the console instead.
# Gmail example: smtp.gmail.com / 587 / TLS, with an app password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
DEFAULT_FROM_EMAIL=HJS Transport <no-reply@your-domain.com>

# Traite reminders: payment type to watch, and earliest local hour to send.
TRAITE_PAYMENT_TYPE=Traite
NOTIFY_SEND_HOUR=8
