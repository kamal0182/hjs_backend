# Copy to backend/.env and fill in real values. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
# Optional: separate key for signing JWTs (defaults to SECRET_KEY)
# JWT_SIGNING_KEY=change-me-too

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (required). docker-compose.yml overrides this with its "db" service;
# this value is for running Django directly from a venv against that same database.
DATABASE_URL=postgres://hjs:hjs@localhost:5432/hjs

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Email (SMTP). Leave SMTP_HOST empty to print emails to the console instead.
# Gmail example: smtp.gmail.com / 587 / TLS, with an app password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
DEFAULT_FROM_EMAIL=HJS Transport <no-reply@your-domain.com>

# Traite reminders: payment type to watch, and earliest local hour to send.
TRAITE_PAYMENT_TYPE=Traite
NOTIFY_SEND_HOUR=8
